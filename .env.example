# API binds to loopback by default.
BTC_KIT_ADDR=127.0.0.1:8080
# For non-loopback binding, set a random key with at least 32 characters.
# BTC_KIT_API_KEY=replace-with-a-long-random-secret
# Optional fee provider override:
# BTC_KIT_FEE_URL=https://mempool.space/api/v1/fees/recommended

# Optional Bitcoin Core RPC:
# BTC_RPC_URL=http://127.0.0.1:8332/
# BTC_RPC_USER=btc_kit_readonly
# BTC_RPC_PASS=replace-with-rpc-password
